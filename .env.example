
# OMP Control registry API
OMP_CONTROL_HOST=127.0.0.1
OMP_CONTROL_PORT=48767
# Optional; defaults to ./data/omp-control.sqlite
# OMP_CONTROL_DB_PATH=./data/omp-control.sqlite
# Set true when served over HTTPS (for example behind a TLS reverse proxy).
# Keep false for localhost development only.
OMP_CONTROL_COOKIE_SECURE=false
