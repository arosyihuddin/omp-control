[Unit]
Description=OMP Control Dashboard
After=network.target

[Service]
Type=simple
User=era
Group=era
WorkingDirectory=/home/era/Documents/Rosik/omp/omp-control
Environment=HOME=/home/era
Environment=NODE_ENV=production
Environment=HTTP_HOST=0.0.0.0
Environment=HTTP_PORT=5173
ExecStart=/opt/omp-mcp/bin/bun run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
