{
  "name": "omp-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "bun run --bun vite build",
    "preview": "bun ./build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "cf:dev": "bun run cf:build && wrangler dev",
    "cf:deploy": "bun run cf:ensure-db && bun run cf:migrate:remote && bun run cf:build && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply omp-control --local",
    "cf:migrate:remote": "wrangler d1 migrations apply omp-control --remote",
    "cf:ensure-db": "node scripts/cf-ensure-db.mjs",
    "cf:setup": "bun run cf:ensure-db && bun run cf:migrate:remote",
    "start": "bun ./build/index.js",
    "cf:build": "OMP_CONTROL_TARGET=cloudflare bun run --bun build"
  },
  "devDependencies": {
    "@eslym/sveltekit-adapter-bun": "^2.2.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.52.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  },
  "description": "Multi-instance control plane for OMP-MCP servers"
}
